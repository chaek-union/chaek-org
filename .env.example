# GitHub OAuth
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# Auth
AUTH_SECRET=generate_a_random_secret_here

# GitHub webhook secret (must match the org webhook's Secret; openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=generate_a_random_secret_here

# vLLM (for chatbot and book translation)
VLLM_BASE_URL=http://your_vllm_host:port
VLLM_MODEL=your_model_name
