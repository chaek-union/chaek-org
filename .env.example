# GitHub OAuth
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# Auth
AUTH_SECRET=generate_a_random_secret_here

# GitHub webhook secret (must match the org webhook's Secret; openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=generate_a_random_secret_here

# LLM (llama.cpp OpenAI-compatible server, used for chatbot + book translation)
# The first model returned by /v1/models is used automatically; if it changes
# server-side, the cache self-corrects on the next request.
#
# Served by ~/qwen/compose.yml (Qwen3.8-27B on the local GPU). That service joins
# this project's network, so the app reaches it by container name. Start it with
# `docker compose -f ~/qwen/compose.yml up -d` before bringing this project up.
LLM_BASE_URL=http://qwen-llm:8080
